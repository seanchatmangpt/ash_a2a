(define (domain ash-a2a-diataxis)
  (:requirements :typing :hierarchy)
  (:types subject capability)
  (:predicates
    (admitted ?s - subject)
    (selected ?s - subject)
    (constructed ?s - subject)
    (authorized ?s - subject)
    (done ?s - subject)
    (receipted ?s - subject)
    (verified ?s - subject))

  (:task execute-capability :parameters (?s - subject ?c - capability))
  (:method lawful-execution
    :parameters (?s - subject ?c - capability)
    :task (execute-capability ?s ?c)
    :ordered-subtasks (and
      (select ?s ?c)
      (construct ?s ?c)
      (actuate ?s ?c)
      (receipt ?s)
      (verify ?s)))

  (:action select :parameters (?s - subject ?c - capability)
    :precondition (admitted ?s)
    :effect (selected ?s))
  (:action construct :parameters (?s - subject ?c - capability)
    :precondition (selected ?s)
    :effect (constructed ?s))
  (:action actuate :parameters (?s - subject ?c - capability)
    :precondition (and (constructed ?s) (authorized ?s))
    :effect (done ?s))
  (:action receipt :parameters (?s - subject)
    :precondition (done ?s)
    :effect (receipted ?s))
  (:action verify :parameters (?s - subject)
    :precondition (receipted ?s)
    :effect (verified ?s)))
