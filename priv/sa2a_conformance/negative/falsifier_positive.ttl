# SA2A conformance -- NEGATIVE vector: graph-global falsifier FIRES.
#
# ex:agentA is asserted as both ex:Agent and ex:Revoked, which binds the body of
# the denial rule in rules/denials.n3 (`{ ?a a ex:Agent . ?a a ex:Revoked } =>
# false .`). No per-node shape expresses this: it is a constraint on the
# co-occurrence of two independent class memberships across the whole graph.
# The wasm surfaces it as the N3_DENIAL dialect going REFUSED.

@prefix ex:   <http://example.org/sa2a/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

ex:agentA a ex:Agent ;
    ex:label "Agent A"@en ;
    ex:description "Planning agent for the conformance corpus." ;
    ex:version "1"^^xsd:integer ;
    ex:admittedAt "2026-01-01T00:00:00Z"^^xsd:dateTime ;
    ex:capability ex:capPlan .

ex:agentB a ex:Agent ;
    ex:label "Agent B"@en ;
    ex:description "Routing agent for the conformance corpus." ;
    ex:version "2"^^xsd:integer ;
    ex:admittedAt "2026-01-02T00:00:00Z"^^xsd:dateTime ;
    ex:capability _:capRouteNode .

_:capRouteNode a ex:Capability ;
    ex:label "routing"@en ;
    ex:tier "2"^^xsd:integer .

ex:capPlan a ex:Capability ;
    ex:label "planning"@en ;
    ex:tier "1"^^xsd:integer .

ex:agentA a ex:Revoked .
