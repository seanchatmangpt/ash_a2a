# SA2A conformance -- NEGATIVE vector: SHACL sh:Violation.
#
# ex:capPlan ex:tier is the plain string "high" rather than an xsd:integer,
# tripping ex:CapabilityShape's sh:datatype constraint at sh:Violation severity.
# The focus node is a Capability, which the ShEx shape_map.json does not target,
# so this vector isolates the SHACL dialect at Violation severity.

@prefix ex:   <http://example.org/sa2a/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

ex:agentA a ex:Agent ;
    ex:label "Agent A"@en ;
    ex:description "Planning agent for the conformance corpus." ;
    ex:version "1"^^xsd:integer ;
    ex:admittedAt "2026-01-01T00:00:00Z"^^xsd:dateTime ;
    ex:capability ex:capPlan .

ex:agentB a ex:Agent ;
    ex:label "Agent B"@en ;
    ex:description "Routing agent for the conformance corpus." ;
    ex:version "2"^^xsd:integer ;
    ex:admittedAt "2026-01-02T00:00:00Z"^^xsd:dateTime ;
    ex:capability _:capRouteNode .

_:capRouteNode a ex:Capability ;
    ex:label "routing"@en ;
    ex:tier "2"^^xsd:integer .

ex:capPlan a ex:Capability ;
    ex:label "planning"@en ;
    ex:tier "high" .
