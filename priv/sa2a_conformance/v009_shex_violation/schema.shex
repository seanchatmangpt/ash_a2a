{
  "shapes": [
    {
      "id": "http://example.org/PersonShape",
      "shapeExpr": {
        "type": "Shape",
        "expression": {
          "type": "TripleConstraint",
          "predicate": "http://example.org/name",
          "valueExpr": {
            "type": "NodeConstraint",
            "datatype": "http://www.w3.org/2001/XMLSchema#string"
          },
          "min": 1,
          "max": 1
        }
      }
    }
  ]
}
