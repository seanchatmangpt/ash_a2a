# SA2A conformance -- the admitted GraphLaw knowledge hooks.
#
# Vocabulary is graphlaw's own kh: namespace
# (praxis-graphlaw src/hooks/parsing.rs:58, src/hooks/mod.rs:130-133). Only these
# kh: predicates are admitted by the engine:
#   name on kind var op k window program goal query effect action reason
#   priority after handler
# ...and hook packs are themselves SHACL-validated against the engine's internal
# SHACL_LAW_PACK before extraction, so a malformed hook is a REFUSAL at load
# time, not a silently-ignored triple.
#
# These hooks are concatenated onto the base graph to form the "law graph" that
# run_hooks/2 and validate_all/5 consume.

@prefix kh: <http://seanchatmangpt.github.io/praxis/kh#> .
@prefix ex: <http://example.org/sa2a/> .

ex:hookAgentDelta a kh:Hook ;
    kh:name "sa2a_agent_delta" ;
    kh:kind "delta" ;
    kh:on "assert" ;
    kh:var "a" ;
    kh:effect "emit-delta" .

ex:hookAgentCount a kh:Hook ;
    kh:name "sa2a_agent_count" ;
    kh:kind "count" ;
    kh:var "a" ;
    kh:op ">=" ;
    kh:k 1 ;
    kh:effect "emit-delta" .
