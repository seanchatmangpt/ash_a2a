---
to: "priv/dfcm/fleet/standing-release.json"
---
<%
bool = fn value -> to_string(value) == "true" end
split = fn value -> value |> to_string() |> String.split("||", trim: true) end
doc = %{
  "id" => @id,
  "module" => @module_name,
  "repository" => @repository,
  "sha" => @sha,
  "subject" => @subject,
  "capability" => @capability,
  "owner" => @owner,
  "authority" => @authority,
  "consequence" => @consequence,
  "reuse" => split.(@reuse_items),
  "negative_knowledge" => split.(@negative_items),
  "falsifier" => @falsifier,
  "standing_source" => @standing_source,
  "technical_standing" => @technical_standing,
  "external_standing" => @external_standing,
  "runtime_authority" => @runtime_authority,
  "requires_exact_subject" => bool.(@requires_exact_subject),
  "requires_release_binding" => bool.(@requires_release_binding),
  "requires_frozen_closure" => bool.(@requires_frozen_closure),
  "requires_receipt_replay_binding" => bool.(@requires_receipt_replay_binding)
}
%><%= Jason.encode!(doc, pretty: true) %>
