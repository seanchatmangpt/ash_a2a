# spec.rq -- singleton-row extraction of the ash_a2a AshExtensionSpec plus its
# nested Skill / Skill.Argument entity shape.
#
# FIXED (Zach-Daniel-review-driven finish-all pass, v26.9.10): this query
# previously declared `PREFIX aex: <.../ash-extension-core#>` and a
# generic aex:DslSection/aex:DslEntity/sectionOf/entityOf shape written
# before ontology.ttl existed (per this file's own prior note). The real,
# authored ontology.ttl declares `@prefix ash_a2a: <.../ash-a2a#>` with a
# concrete, non-generic vocabulary: `ash_a2a:SkillEntity` linked to
# `ash_a2a:AshExtensionSpec` via `ash_a2a:skillOf` (not a generic
# DslSection/DslEntity/sectionOf/entityOf chain), and the nested argument
# entity linked via `ash_a2a:nestedOf` (not `entityOf`). This rewrite binds
# against the real ontology.ttl as it actually exists.
#
# Row shape (singleton, one row per AshExtensionSpec):
#   ?package_name    -- ash_a2a:packageName          (hex package name, e.g. "ash_a2a")
#   ?module_name     -- ash_a2a:moduleName            (top Elixir module, e.g. "AshA2A")
#   ?skill_entity    -- SAMPLE of ash_a2a:entityName on the :skill SkillEntity
#   ?skill_struct    -- SAMPLE of ash_a2a:entityStruct on that SkillEntity
#   ?argument_entity -- SAMPLE of ash_a2a:argumentEntityName on the nested ArgumentEntity
#   ?argument_struct -- SAMPLE of ash_a2a:argumentEntityStruct on that ArgumentEntity

PREFIX ash_a2a: <http://seanchatmangpt.github.io/packs/ash-a2a#>

SELECT DISTINCT ?package_name ?module_name
       (SAMPLE(?skill_entity)    AS ?skill_entity)
       (SAMPLE(?skill_struct)    AS ?skill_struct)
       (SAMPLE(?argument_entity) AS ?argument_entity)
       (SAMPLE(?argument_struct) AS ?argument_struct)
WHERE {
  ?spec a ash_a2a:AshExtensionSpec ;
        ash_a2a:packageName ?package_name ;
        ash_a2a:moduleName ?module_name .

  OPTIONAL {
    ?skill a ash_a2a:SkillEntity ;
           ash_a2a:skillOf ?spec ;
           ash_a2a:entityName ?skill_entity ;
           ash_a2a:entityStruct ?skill_struct .

    OPTIONAL {
      ?argument a ash_a2a:ArgumentEntity ;
                ash_a2a:nestedOf ?skill ;
                ash_a2a:argumentEntityName ?argument_entity ;
                ash_a2a:argumentEntityStruct ?argument_struct .
    }
  }
}
GROUP BY ?package_name ?module_name
