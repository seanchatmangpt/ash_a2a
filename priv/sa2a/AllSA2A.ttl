@prefix dct:          <http://purl.org/dc/terms/> .
@prefix owl:          <http://www.w3.org/2002/07/owl#> .
@prefix rdf:          <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:         <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:         <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:          <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:           <http://www.w3.org/ns/shacl#> .
@prefix a2a-urn:      <urn:ash-a2a:vocab:> .
@prefix sa2a-spec:    <https://spec.seanchatmangpt.dev/sa2a/ontology/MetadataSA2A/> .
@prefix sa2a-fnd-agt: <https://spec.seanchatmangpt.dev/sa2a/ontology/FND/Agents/Agents/> .
@prefix sa2a-fnd-agr: <https://spec.seanchatmangpt.dev/sa2a/ontology/FND/Agreements/Leases/> .
@prefix sa2a-fnd-law: <https://spec.seanchatmangpt.dev/sa2a/ontology/FND/Law/OperatingDoctrine/> .
@prefix sa2a-cap:     <https://spec.seanchatmangpt.dev/sa2a/ontology/CAP/CoreCapabilities/> .
@prefix sa2a-bp:      <https://spec.seanchatmangpt.dev/sa2a/ontology/BP/ExecutionEnvelopes/> .
@prefix sa2a-evi:     <https://spec.seanchatmangpt.dev/sa2a/ontology/EVI/Receipts/> .
@prefix ex-shacl:     <https://spec.seanchatmangpt.dev/sa2a/shapes/core#> .

#################################################################
# 1. TOP-LEVEL METADATA & SPECIFICATION ROOT
#################################################################

<https://spec.seanchatmangpt.dev/sa2a/ontology/AllSA2A/>
    a owl:Ontology ;
    rdfs:label "All SA2A (Consolidated Canonical Specification)" ;
    dct:title "Semantic Agent-to-Agent (SA2A) Unified Ontology Standard" ;
    dct:abstract "Single self-contained Turtle specification uniting all Semantic Agent-to-Agent (SA2A) domains, foundations, capabilities, processes, evidence receipts, doctrine laws, and SHACL shapes. Modeled after FIBO AllFND and AboutFIBOProd distributions." ;
    dct:issued "2026-10-04T00:00:00"^^xsd:dateTime ;
    dct:modified "2026-10-04T09:30:00"^^xsd:dateTime ;
    dct:license "MIT" ;
    owl:versionIRI <https://spec.seanchatmangpt.dev/sa2a/ontology/20261004/AllSA2A/> .

sa2a-spec:SA2ASpecification
    a owl:NamedIndividual ;
    rdfs:label "Semantic Agent-to-Agent (SA2A) Specification" ;
    dct:title "Semantic Agent-to-Agent (SA2A) Specification" ;
    dct:abstract "SA2A defines the standardized conceptual architecture for verifiable agentic coordination, zero-mock semantic actuation, and authority-bounded receipt generation." ;
    skos:altLabel "SA2A Specification" .

#################################################################
# 2. FOUNDATIONS (FND) - AGENTS & AUTONOMOUS ACTORS
#################################################################

sa2a-fnd-agt:AutonomousAgent
    a owl:Class ;
    rdfs:label "autonomous agent" ;
    skos:definition "A computational entity capable of sensing environment states, reasoning over goals, and dispatching bounded actuations without immediate step-by-step human intervention." .

sa2a-fnd-agt:SoftwareSystem
    a owl:Class ;
    rdfs:subClassOf sa2a-fnd-agt:AutonomousAgent ;
    rdfs:label "software system" ;
    skos:definition "A discrete executable program or GenServer process runtime." .

sa2a-fnd-agt:VerificationCourt
    a owl:Class ;
    rdfs:subClassOf sa2a-fnd-agt:AutonomousAgent ;
    rdfs:label "verification court" ;
    skos:definition "An adversarial evaluation agent whose authority is strictly bounded to issuing verifiable PASS, REFUSED, or BLOCKED judgments over candidate artifacts." .

sa2a-fnd-agt:Principal
    a owl:Class ;
    rdfs:label "principal" ;
    skos:definition "The entity (human or organization) in whose legal or administrative authority an agent acts." .

sa2a-fnd-agt:actsOnBehalfOf
    a owl:ObjectProperty ;
    rdfs:label "acts on behalf of" ;
    rdfs:domain sa2a-fnd-agt:AutonomousAgent ;
    rdfs:range sa2a-fnd-agt:Principal .

#################################################################
# 3. FOUNDATIONS (FND) - AGREEMENTS, LEASES & AUTHORITY CEILINGS
#################################################################

sa2a-fnd-agr:AuthorityCeiling
    a owl:Class ;
    rdfs:label "authority ceiling" ;
    skos:definition "The maximal boundary of permitted actions (e.g. read-only, construct-only, bounded DO) granted to an agent." .

sa2a-fnd-agr:ActuationLease
    a owl:Class ;
    rdfs:label "actuation lease" ;
    skos:definition "A time-bound cryptographic token or grant authorizing a specific agent to actuate within an AuthorityCeiling." .

sa2a-fnd-agr:hasCeiling
    a owl:ObjectProperty ;
    rdfs:domain sa2a-fnd-agr:ActuationLease ;
    rdfs:range sa2a-fnd-agr:AuthorityCeiling .

sa2a-fnd-agr:leaseHolder
    a owl:ObjectProperty ;
    rdfs:domain sa2a-fnd-agr:ActuationLease ;
    rdfs:range sa2a-fnd-agt:AutonomousAgent .

sa2a-fnd-agr:leaseExpiration
    a owl:DatatypeProperty ;
    rdfs:domain sa2a-fnd-agr:ActuationLease ;
    rdfs:range xsd:dateTime .

#################################################################
# 4. FOUNDATIONS (FND) - OPERATING DOCTRINE LAWS
#################################################################

sa2a-fnd-law:DoctrineLaw
    a owl:Class ;
    rdfs:label "doctrine law" ;
    skos:definition "A fundamental operational invariance invariant across all agent interactions." .

sa2a-fnd-law:SelectNotConstruct
    a sa2a-fnd-law:DoctrineLaw ;
    rdfs:label "Select Not Construct" ;
    skos:definition "Selecting from existing admitted options precedes constructing novel artifacts. Novelty must be minimized." .

sa2a-fnd-law:ConstructNotDo
    a sa2a-fnd-law:DoctrineLaw ;
    rdfs:label "Construct Not Do" ;
    skos:definition "Generating, modeling, or compiling code/plans does not constitute execution authority. Planning is strictly distinct from actuating." .

sa2a-fnd-law:IntentNotAuthority
    a sa2a-fnd-law:DoctrineLaw ;
    rdfs:label "Intent Not Authority" ;
    skos:definition "Prompts, plans, LLM completions, and user intentions are candidate hypotheses, never execution authority." .

sa2a-fnd-law:ReceiptNotSuccess
    a sa2a-fnd-law:DoctrineLaw ;
    rdfs:label "Receipt Not Success" ;
    skos:definition "A receipt records five-part factual evidence of an actuation event; it is not synonymous with arbitrary subjective claims of success." .

#################################################################
# 5. FOUNDATIONS (FND) - RUNTIME EQUIVALENCE BRIDGE
#################################################################

a2a-urn:Command owl:equivalentClass sa2a-bp:CommandEnvelope .
a2a-urn:Receipt owl:equivalentClass sa2a-evi:ActuationReceipt .

a2a-urn:capabilityId  owl:equivalentProperty sa2a-bp:capabilityId .
a2a-urn:principalId   owl:equivalentProperty sa2a-bp:principalId .
a2a-urn:payloadDigest owl:equivalentProperty sa2a-bp:payloadDigest .

#################################################################
# 6. CAPABILITIES & AFFORDANCES (CAP)
#################################################################

sa2a-cap:Capability
    a owl:Class ;
    rdfs:label "capability" ;
    skos:definition "An executable affordance or action boundary that an agent is equipped to perform." .

sa2a-cap:DiscoverCapability   a sa2a-cap:Capability ; rdfs:label "Discover Capability" .
sa2a-cap:SelectCapability     a sa2a-cap:Capability ; rdfs:label "Select Capability" .
sa2a-cap:ConstructCapability  a sa2a-cap:Capability ; rdfs:label "Construct Capability" .
sa2a-cap:DoCapability         a sa2a-cap:Capability ; rdfs:label "Do Capability" .
sa2a-cap:ReceiptCapability    a sa2a-cap:Capability ; rdfs:label "Receipt Capability" .
sa2a-cap:ReplayCapability     a sa2a-cap:Capability ; rdfs:label "Replay Capability" .

#################################################################
# 7. BUSINESS PROCESS & EXECUTION ENVELOPES (BP)
#################################################################

sa2a-bp:CommandEnvelope
    a owl:Class ;
    rdfs:label "command envelope" ;
    skos:definition "A self-contained, canonical message requesting an actuation." .

sa2a-bp:capabilityId
    a owl:DatatypeProperty ;
    rdfs:domain sa2a-bp:CommandEnvelope ;
    rdfs:range xsd:string .

sa2a-bp:principalId
    a owl:DatatypeProperty ;
    rdfs:domain sa2a-bp:CommandEnvelope ;
    rdfs:range xsd:string .

sa2a-bp:payloadDigest
    a owl:DatatypeProperty ;
    rdfs:domain sa2a-bp:CommandEnvelope ;
    rdfs:range xsd:string .

sa2a-bp:idempotencyKey
    a owl:DatatypeProperty ;
    rdfs:domain sa2a-bp:CommandEnvelope ;
    rdfs:range xsd:string .

#################################################################
# 8. EVIDENCE & RECEIPTS (EVI) - CHATMAN EQUATION
#################################################################

sa2a-evi:ActuationReceipt
    a owl:Class ;
    rdfs:label "actuation receipt" ;
    skos:definition "Cryptographic and factual record of an executed actuation embodying R = receipt(A) = {identity, authority, consequence, replay, standing}." .

sa2a-evi:subjectIdentity
    a owl:DatatypeProperty ;
    rdfs:label "exact subject identity SHA" ;
    rdfs:domain sa2a-evi:ActuationReceipt ;
    rdfs:range xsd:string .

sa2a-evi:authorizingLease
    a owl:ObjectProperty ;
    rdfs:label "authorizing lease" ;
    rdfs:domain sa2a-evi:ActuationReceipt ;
    rdfs:range sa2a-fnd-agr:ActuationLease .

sa2a-evi:consequenceSummary
    a owl:DatatypeProperty ;
    rdfs:label "consequence summary" ;
    rdfs:domain sa2a-evi:ActuationReceipt ;
    rdfs:range xsd:string .

sa2a-evi:replayCommand
    a owl:DatatypeProperty ;
    rdfs:label "deterministic replay command" ;
    rdfs:domain sa2a-evi:ActuationReceipt ;
    rdfs:range xsd:string .

sa2a-evi:verificationStanding
    a owl:DatatypeProperty ;
    rdfs:label "derived standing status" ;
    rdfs:domain sa2a-evi:ActuationReceipt ;
    rdfs:range xsd:string .

#################################################################
# 9. MACHINE SHACL CONFORMANCE SHAPES
#################################################################

ex-shacl:CommandEnvelopeShape
    a sh:NodeShape ;
    sh:targetClass sa2a-bp:CommandEnvelope ;
    sh:property [
        sh:path sa2a-bp:capabilityId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path sa2a-bp:principalId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path sa2a-bp:payloadDigest ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] .

ex-shacl:ActuationReceiptShape
    a sh:NodeShape ;
    sh:targetClass sa2a-evi:ActuationReceipt ;
    sh:property [
        sh:path sa2a-evi:subjectIdentity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path sa2a-evi:authorizingLease ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class sa2a-fnd-agr:ActuationLease ;
    ] ;
    sh:property [
        sh:path sa2a-evi:consequenceSummary ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path sa2a-evi:replayCommand ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path sa2a-evi:verificationStanding ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] .
