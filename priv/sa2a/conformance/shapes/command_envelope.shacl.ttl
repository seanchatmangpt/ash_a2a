@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix a2a:  <urn:ash-a2a:vocab:> .
@prefix ex:   <urn:ash-a2a:conformance:shapes:> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

ex:CommandShape
    a               sh:NodeShape ;
    sh:targetClass  a2a:Command ;
    sh:property [
        sh:path     a2a:capabilityId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path     a2a:principalId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path     a2a:payloadDigest ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] .
