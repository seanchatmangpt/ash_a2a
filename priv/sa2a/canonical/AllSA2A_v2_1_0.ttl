@prefix rdf:          <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:         <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:          <http://www.w3.org/2002/07/owl#> .
@prefix xsd:          <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:      <http://purl.org/dc/terms/> .
@prefix prov:         <http://www.w3.org/ns/prov#> .
@prefix sh:           <http://www.w3.org/ns/shacl#> .
@prefix skos:         <http://www.w3.org/2004/02/skos/core#> .
@prefix a2a:          <https://a2a-protocol.org/ontology#> .
@prefix sa2a-law:     <https://spec.seanchatmangpt.dev/sa2a/ontology/FND/Law/OperatingDoctrine/> .
@prefix sa2a-evi:     <https://spec.seanchatmangpt.dev/sa2a/ontology/EVI/Receipts/> .
@prefix sa2a-agr:     <https://spec.seanchatmangpt.dev/sa2a/ontology/FND/Agreements/Leases/> .

#################################################################
#    Unified Ontology Declaration
#################################################################

<https://spec.seanchatmangpt.dev/sa2a/ontology/AllSA2A_v2_1_0/>
    rdf:type owl:Ontology ;
    owl:versionInfo "2.1.0-sa2a" ;
    dcterms:title "Agent2Agent (A2A) v2.1.0 Unified Protocol & Semantic Execution Ontology"@en ;
    dcterms:description "Consolidated OWL-DL ontology unifying the canonical A2A v2.1.0 protocol (AgentCards, Tasks, Messages, polymorphic Parts, Artifacts, SHACL shapes) with the Sean Chatman Operating Doctrine explanation laws and 5-field verifiable actuation receipts."@en ;
    owl:imports <https://a2a-protocol.org/ontology#> .

#################################################################
#    1. A2A PROTOCOL V2.1.0 CORE SPECIFICATION
#################################################################

### Classes: Identity & Discovery
a2a:AgentCard
    rdf:type owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Agent Card"@en ;
    rdfs:comment "Self-describing discovery manifest advertising endpoints, capabilities, and authentication requirements."@en .

a2a:Skill
    rdf:type owl:Class ;
    rdfs:label "Skill"@en ;
    rdfs:comment "A discrete capability exposed by an agent with explicit input/output mode declarations."@en .

a2a:SecurityScheme
    rdf:type owl:Class ;
    rdfs:label "Security Scheme"@en ;
    rdfs:comment "Authentication specification governing endpoint access."@en .

a2a:APIKeyAuth
    rdf:type owl:Class ;
    rdfs:subClassOf a2a:SecurityScheme ;
    rdfs:label "API Key Auth"@en .

a2a:HTTPAuth
    rdf:type owl:Class ;
    rdfs:subClassOf a2a:SecurityScheme ;
    rdfs:label "HTTP Bearer / Basic Auth"@en .

a2a:OAuth2Auth
    rdf:type owl:Class ;
    rdfs:subClassOf a2a:SecurityScheme ;
    rdfs:label "OAuth2 Auth"@en .

### Classes: Execution Lifecycle & Communication
a2a:Task
    rdf:type owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Task"@en ;
    rdfs:comment "Stateful execution unit initiated by a client and processed by an agent."@en .

a2a:TaskState
    rdf:type owl:Class ;
    rdfs:label "Task State"@en ;
    rdfs:comment "Finite lifecycle states for a task."@en .

a2a:Context
    rdf:type owl:Class ;
    rdfs:label "Execution Context"@en ;
    rdfs:comment "Grouping identifier binding related tasks and multi-turn message exchanges."@en .

a2a:Message
    rdf:type owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Message Turn"@en ;
    rdfs:comment "An exchange unit containing ordered multimodal content parts."@en .

a2a:MessageRole
    rdf:type owl:Class ;
    rdfs:label "Message Role"@en ;
    rdfs:comment "Originator identity of a message turn."@en .

a2a:Part
    rdf:type owl:Class ;
    rdfs:label "Content Part"@en ;
    rdfs:comment "Polymorphic payload atom carrying text, raw binary data, external URIs, or structured JSON."@en .

a2a:Artifact
    rdf:type owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Task Artifact"@en ;
    rdfs:comment "Concrete intermediate or final output produced during task execution."@en .

### Object Properties
a2a:advertisesSkill
    rdf:type owl:ObjectProperty ;
    rdfs:domain a2a:AgentCard ;
    rdfs:range a2a:Skill ;
    rdfs:label "advertises skill"@en .

a2a:requiresAuth
    rdf:type owl:ObjectProperty ;
    rdfs:domain a2a:AgentCard ;
    rdfs:range a2a:SecurityScheme ;
    rdfs:label "requires auth"@en .

a2a:hasTaskState
    rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain a2a:Task ;
    rdfs:range a2a:TaskState ;
    rdfs:label "has task state"@en .

a2a:hasMessage
    rdf:type owl:ObjectProperty ;
    rdfs:domain a2a:Task ;
    rdfs:range a2a:Message ;
    rdfs:label "has message"@en .

a2a:hasRole
    rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain a2a:Message ;
    rdfs:range a2a:MessageRole ;
    rdfs:label "has role"@en .

a2a:hasPart
    rdf:type owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf (a2a:Message a2a:Artifact) ] ;
    rdfs:range a2a:Part ;
    rdfs:label "has content part"@en .

a2a:yieldsArtifact
    rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:generated ;
    rdfs:domain a2a:Task ;
    rdfs:range a2a:Artifact ;
    rdfs:label "yields artifact"@en .

a2a:belongsToContext
    rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain a2a:Task ;
    rdfs:range a2a:Context ;
    rdfs:label "belongs to context"@en .

### Datatype Properties
a2a:serviceEndpoint
    rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain a2a:AgentCard ;
    rdfs:range xsd:anyURI ;
    rdfs:label "service endpoint"@en .

a2a:protocolVersion
    rdf:type owl:DatatypeProperty ;
    rdfs:domain a2a:AgentCard ;
    rdfs:range xsd:string ;
    rdfs:label "protocol version"@en .

a2a:agentName
    rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain a2a:AgentCard ;
    rdfs:range xsd:string ;
    rdfs:label "agent name"@en .

a2a:skillId
    rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain a2a:Skill ;
    rdfs:range xsd:string ;
    rdfs:label "skill ID"@en .

a2a:taskId
    rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain a2a:Task ;
    rdfs:range xsd:string ;
    rdfs:label "task ID"@en .

a2a:contextId
    rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain a2a:Context ;
    rdfs:range xsd:string ;
    rdfs:label "context ID"@en .

a2a:partText
    rdf:type owl:DatatypeProperty ;
    rdfs:domain a2a:Part ;
    rdfs:range xsd:string ;
    rdfs:label "text body"@en .

a2a:partRaw
    rdf:type owl:DatatypeProperty ;
    rdfs:domain a2a:Part ;
    rdfs:range xsd:base64Binary ;
    rdfs:label "raw base64 bytes"@en .

a2a:partUrl
    rdf:type owl:DatatypeProperty ;
    rdfs:domain a2a:Part ;
    rdfs:range xsd:anyURI ;
    rdfs:label "remote URL"@en .

a2a:partData
    rdf:type owl:DatatypeProperty ;
    rdfs:domain a2a:Part ;
    rdfs:range xsd:string ;
    rdfs:label "structured JSON data"@en .

a2a:mimeType
    rdf:type owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (a2a:Part a2a:Artifact) ] ;
    rdfs:range xsd:string ;
    rdfs:label "MIME type"@en .

a2a:artifactName
    rdf:type owl:DatatypeProperty ;
    rdfs:domain a2a:Artifact ;
    rdfs:range xsd:string ;
    rdfs:label "artifact name"@en .

a2a:timestamp
    rdf:type owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (a2a:Task a2a:Message a2a:Artifact) ] ;
    rdfs:range xsd:dateTime ;
    rdfs:label "creation timestamp"@en .

### Controlled Vocabulary Individuals
a2a:Submitted       rdf:type a2a:TaskState ; rdfs:label "submitted"@en .
a2a:Working         rdf:type a2a:TaskState ; rdfs:label "working"@en .
a2a:InputRequired   rdf:type a2a:TaskState ; rdfs:label "input-required"@en .
a2a:Completed       rdf:type a2a:TaskState ; rdfs:label "completed"@en .
a2a:Failed          rdf:type a2a:TaskState ; rdfs:label "failed"@en .
a2a:Cancelled       rdf:type a2a:TaskState ; rdfs:label "cancelled"@en .

a2a:RoleUser        rdf:type a2a:MessageRole ; rdfs:label "user"@en .
a2a:RoleAgent       rdf:type a2a:MessageRole ; rdfs:label "agent"@en .

#################################################################
#    2. OPERATING DOCTRINE LAWS & RECEIPT INTEGRATION
#################################################################

sa2a-law:DoctrineLaw
    rdf:type owl:Class ;
    rdfs:label "doctrine law"@en ;
    skos:definition "A fundamental operational invariance invariant across all agent interactions."@en .

sa2a-law:SelectNotConstruct
    rdf:type sa2a-law:DoctrineLaw ;
    rdfs:label "Select Not Construct"@en ;
    skos:definition "Selecting from existing admitted options precedes constructing novel artifacts. Novelty must be minimized."@en .

sa2a-law:ConstructNotDo
    rdf:type sa2a-law:DoctrineLaw ;
    rdfs:label "Construct Not Do"@en ;
    skos:definition "Generating, modeling, or compiling code/plans does not constitute execution authority. Planning is strictly distinct from actuating."@en .

sa2a-law:IntentNotAuthority
    rdf:type sa2a-law:DoctrineLaw ;
    rdfs:label "Intent Not Authority"@en ;
    skos:definition "Prompts, plans, LLM completions, and user intentions are candidate hypotheses, never execution authority."@en .

sa2a-law:ReceiptNotSuccess
    rdf:type sa2a-law:DoctrineLaw ;
    rdfs:label "Receipt Not Success"@en ;
    skos:definition "A receipt records five-part factual evidence of an actuation event; it is not synonymous with arbitrary subjective claims of success."@en .

sa2a-evi:ActuationReceipt
    rdf:type owl:Class ;
    rdfs:subClassOf a2a:Artifact ;
    rdfs:label "actuation receipt"@en ;
    skos:definition "Cryptographic and factual record of an executed actuation embodying R = receipt(A) = {identity, authority, consequence, replay, standing}."@en .

sa2a-evi:subjectIdentity
    rdf:type owl:DatatypeProperty ;
    rdfs:domain sa2a-evi:ActuationReceipt ;
    rdfs:range xsd:string ;
    rdfs:label "exact subject identity SHA"@en .

sa2a-evi:authorizingLease
    rdf:type owl:ObjectProperty ;
    rdfs:domain sa2a-evi:ActuationReceipt ;
    rdfs:range sa2a-agr:ActuationLease ;
    rdfs:label "authorizing lease"@en .

sa2a-evi:consequenceSummary
    rdf:type owl:DatatypeProperty ;
    rdfs:domain sa2a-evi:ActuationReceipt ;
    rdfs:range xsd:string ;
    rdfs:label "consequence summary"@en .

sa2a-evi:replayCommand
    rdf:type owl:DatatypeProperty ;
    rdfs:domain sa2a-evi:ActuationReceipt ;
    rdfs:range xsd:string ;
    rdfs:label "deterministic replay command"@en .

sa2a-evi:verificationStanding
    rdf:type owl:DatatypeProperty ;
    rdfs:domain sa2a-evi:ActuationReceipt ;
    rdfs:range xsd:string ;
    rdfs:label "derived standing status"@en .

#################################################################
#    3. SHACL CONSTRAINT SHAPES
#################################################################

a2a:AgentCardShape
    rdf:type sh:NodeShape ;
    sh:targetClass a2a:AgentCard ;
    sh:property [
        sh:path a2a:serviceEndpoint ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path a2a:protocolVersion ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path a2a:agentName ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path a2a:advertisesSkill ;
        sh:class a2a:Skill ;
        sh:minCount 1 ;
    ] .

a2a:TaskShape
    rdf:type sh:NodeShape ;
    sh:targetClass a2a:Task ;
    sh:property [
        sh:path a2a:taskId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path a2a:hasTaskState ;
        sh:class a2a:TaskState ;
        sh:in ( a2a:Submitted a2a:Working a2a:InputRequired a2a:Completed a2a:Failed a2a:Cancelled ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path a2a:hasMessage ;
        sh:class a2a:Message ;
    ] ;
    sh:property [
        sh:path a2a:yieldsArtifact ;
        sh:class a2a:Artifact ;
    ] .

a2a:MessageShape
    rdf:type sh:NodeShape ;
    sh:targetClass a2a:Message ;
    sh:property [
        sh:path a2a:hasRole ;
        sh:class a2a:MessageRole ;
        sh:in ( a2a:RoleUser a2a:RoleAgent ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path a2a:hasPart ;
        sh:class a2a:Part ;
        sh:minCount 1 ;
    ] .

a2a:PartPayloadShape
    rdf:type sh:NodeShape ;
    sh:targetClass a2a:Part ;
    sh:message "An a2a:Part instance must encapsulate exactly one payload property (partText, partRaw, partUrl, or partData)."@en ;
    sh:xone (
        [
            sh:property [
                sh:path a2a:partText ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ]
        ]
        [
            sh:property [
                sh:path a2a:partRaw ;
                sh:datatype xsd:base64Binary ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ]
        ]
        [
            sh:property [
                sh:path a2a:partUrl ;
                sh:datatype xsd:anyURI ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ]
        ]
        [
            sh:property [
                sh:path a2a:partData ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ]
        ]
    ) .

a2a:ArtifactShape
    rdf:type sh:NodeShape ;
    sh:targetClass a2a:Artifact ;
    sh:property [
        sh:path a2a:hasPart ;
        sh:class a2a:Part ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path a2a:artifactName ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] .

#################################################################
#    4. FORMAL OWL-DL DISJOINTNESS & EXTENDED SHAPES
#################################################################

sa2a-evi:VerificationStanding a owl:Class ;
    rdfs:label "verification standing" ;
    rdfs:comment "Formal outcome emitted by an sa2a-fnd-agt:VerificationCourt." .

sa2a-evi:StandingPass    a sa2a-evi:VerificationStanding ; rdfs:label "PASS" .
sa2a-evi:StandingRefused a sa2a-evi:VerificationStanding ; rdfs:label "REFUSED" .
sa2a-evi:StandingBlocked a sa2a-evi:VerificationStanding ; rdfs:label "BLOCKED" .

sa2a-evi:hasStanding a owl:ObjectProperty ;
    rdfs:domain sa2a-evi:ActuationReceipt ;
    rdfs:range sa2a-evi:VerificationStanding .

sa2a-agr:leaseTokenHash a owl:DatatypeProperty ;
    rdfs:domain sa2a-agr:ActuationLease ;
    rdfs:range xsd:string ;
    rdfs:comment "SHA-256 digest of the cryptographic bearer token granting bounded actuation." .

sa2a-agr:ActuationLeaseShape
    a sh:NodeShape ;
    sh:targetClass sa2a-agr:ActuationLease ;
    sh:property [
        sh:path sa2a-agr:leaseHolder ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path sa2a-agr:hasCeiling ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path sa2a-agr:leaseExpiration ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
    ] ;
    sh:property [
        sh:path sa2a-agr:leaseTokenHash ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[a-fA-F0-9]{64}$" ;
    ] .

sa2a-evi:ActuationReceiptVerificationShape
    a sh:NodeShape ;
    sh:targetClass sa2a-evi:ActuationReceipt ;
    sh:property [
        sh:path sa2a-evi:hasStanding ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( sa2a-evi:StandingPass sa2a-evi:StandingRefused sa2a-evi:StandingBlocked ) ;
    ] ;
    sh:property [
        sh:path sa2a-evi:executedAt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
    ] .
