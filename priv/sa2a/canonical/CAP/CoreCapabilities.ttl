@prefix dct:      <http://purl.org/dc/terms/> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix sa2a-cap: <https://spec.seanchatmangpt.dev/sa2a/ontology/CAP/CoreCapabilities/> .

<https://spec.seanchatmangpt.dev/sa2a/ontology/CAP/CoreCapabilities/>
    a owl:Ontology ;
    rdfs:label "Core Capabilities and Affordances Ontology" ;
    dct:abstract "Standard ontology of discrete agent capabilities and operational stages." ;
    dct:license "MIT" ;
    owl:versionIRI <https://spec.seanchatmangpt.dev/sa2a/ontology/20261004/CAP/CoreCapabilities/> .

sa2a-cap:Capability
    a owl:Class ;
    rdfs:label "capability" ;
    skos:definition "An executable affordance or action boundary that an agent is equipped to perform." .

sa2a-cap:DiscoverCapability   a sa2a-cap:Capability ; rdfs:label "Discover Capability" .
sa2a-cap:SelectCapability     a sa2a-cap:Capability ; rdfs:label "Select Capability" .
sa2a-cap:ConstructCapability  a sa2a-cap:Capability ; rdfs:label "Construct Capability" .
sa2a-cap:DoCapability         a sa2a-cap:Capability ; rdfs:label "Do Capability" .
sa2a-cap:ReceiptCapability    a sa2a-cap:Capability ; rdfs:label "Receipt Capability" .
sa2a-cap:ReplayCapability     a sa2a-cap:Capability ; rdfs:label "Replay Capability" .
