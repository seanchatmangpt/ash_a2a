@prefix dct:     <http://purl.org/dc/terms/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix sa2a-bp: <https://spec.seanchatmangpt.dev/sa2a/ontology/BP/ExecutionEnvelopes/> .

<https://spec.seanchatmangpt.dev/sa2a/ontology/BP/ExecutionEnvelopes/>
    a owl:Ontology ;
    rdfs:label "Business Process and Execution Envelopes Ontology" ;
    dct:abstract "Formalizes command envelopes, idempotency tokens, and execution boundaries for agent actuations." ;
    dct:license "MIT" ;
    owl:versionIRI <https://spec.seanchatmangpt.dev/sa2a/ontology/20261004/BP/ExecutionEnvelopes/> .

sa2a-bp:CommandEnvelope
    a owl:Class ;
    rdfs:label "command envelope" ;
    skos:definition "A self-contained, canonical message requesting an actuation." .

sa2a-bp:capabilityId
    a owl:DatatypeProperty ;
    rdfs:domain sa2a-bp:CommandEnvelope ;
    rdfs:range xsd:string .

sa2a-bp:principalId
    a owl:DatatypeProperty ;
    rdfs:domain sa2a-bp:CommandEnvelope ;
    rdfs:range xsd:string .

sa2a-bp:payloadDigest
    a owl:DatatypeProperty ;
    rdfs:domain sa2a-bp:CommandEnvelope ;
    rdfs:range xsd:string .

sa2a-bp:idempotencyKey
    a owl:DatatypeProperty ;
    rdfs:domain sa2a-bp:CommandEnvelope ;
    rdfs:range xsd:string .
