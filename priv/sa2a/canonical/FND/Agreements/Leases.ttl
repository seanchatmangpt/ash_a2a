@prefix dct:          <http://purl.org/dc/terms/> .
@prefix owl:          <http://www.w3.org/2002/07/owl#> .
@prefix rdf:          <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:         <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:         <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:          <http://www.w3.org/2001/XMLSchema#> .
@prefix sa2a-fnd-agr: <https://spec.seanchatmangpt.dev/sa2a/ontology/FND/Agreements/Leases/> .
@prefix sa2a-fnd-agt: <https://spec.seanchatmangpt.dev/sa2a/ontology/FND/Agents/Agents/> .

<https://spec.seanchatmangpt.dev/sa2a/ontology/FND/Agreements/Leases/>
    a owl:Ontology ;
    rdfs:label "Agreements, Leases and Authority Ceilings Ontology" ;
    dct:abstract "Defines explicit contractual grants, temporal leases, and authority limits governing agent actuations." ;
    dct:license "MIT" ;
    owl:versionIRI <https://spec.seanchatmangpt.dev/sa2a/ontology/20261004/FND/Agreements/Leases/> .

sa2a-fnd-agr:AuthorityCeiling
    a owl:Class ;
    rdfs:label "authority ceiling" ;
    skos:definition "The maximal boundary of permitted actions (e.g. read-only, construct-only, bounded DO) granted to an agent." .

sa2a-fnd-agr:ActuationLease
    a owl:Class ;
    rdfs:label "actuation lease" ;
    skos:definition "A time-bound cryptographic token or grant authorizing a specific agent to actuate within an AuthorityCeiling." .

sa2a-fnd-agr:hasCeiling
    a owl:ObjectProperty ;
    rdfs:domain sa2a-fnd-agr:ActuationLease ;
    rdfs:range sa2a-fnd-agr:AuthorityCeiling .

sa2a-fnd-agr:leaseHolder
    a owl:ObjectProperty ;
    rdfs:domain sa2a-fnd-agr:ActuationLease ;
    rdfs:range sa2a-fnd-agt:AutonomousAgent .

sa2a-fnd-agr:leaseExpiration
    a owl:DatatypeProperty ;
    rdfs:domain sa2a-fnd-agr:ActuationLease ;
    rdfs:range xsd:dateTime .
