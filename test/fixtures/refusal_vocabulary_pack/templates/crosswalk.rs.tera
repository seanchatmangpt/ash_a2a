//! erlmcp -> ash_a2a refusal crosswalk — GENERATED by `ggen sync run` from
//! the `refusal-vocabulary-pack` ontology. Do not edit by hand.
//!
//! Canonical FAIL-CLOSED crosswalk between erlmcp's integer refusal codes
//! (apps/erlmcp_core/include/erlmcp_refusal.hrl v1.4.0) and ash_a2a's
//! RFC-SA2A-001 S42 refusal classes (lib/ash_a2a/semantic/refusal.ex) with
//! the JSON-RPC error law of lib/ash_a2a/protocol/jsonrpc/error.ex, plus the
//! strata-valve third column (rv:ValveMapping: valve refusal atoms ->
//! ash_a2a classes).
//!
//! Gate suite (run with `rustc --test`): every code appears exactly once,
//! every one of the declared ash_a2a classes is targeted >= 1, every declared
//! jsonRpcCode stays inside the A2A/JSON-RPC law set, and valve totality
//! holds both directions. Classification only: nothing here grants runtime
//! actuation authority.

/// One erlmcp refusal code mapped to exactly one ash_a2a class.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct CrosswalkEntry {
    /// erlmcp ?REFUSAL_* integer code (erlmcp_refusal.hrl).
    pub erlmcp_code: u16,
    /// ash_a2a class atom (AshA2A.Semantic.Refusal).
    pub ash_a2a_class: &'static str,
    /// A2A/JSON-RPC wire code where error.ex defines an applicable law.
    pub json_rpc_code: Option<i32>,
    /// HTTP status from ?REFUSAL_METADATA.
    pub http_status: u16,
    /// warn | error | critical.
    pub severity: &'static str,
}

/// One strata-valve refusal class mapped to one ash_a2a class (third column:
/// rv:ValveMapping).
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct ValveEntry {
    /// strata valve refusal atom (valve.ex) or WindowCapacityRefusal guard.
    pub valve_name: &'static str,
    /// Source module whose guard produced the atom (provenance).
    pub valve_module: &'static str,
    /// Literal guard atom where one exists (e.g. "run.len > 8").
    pub valve_atom: Option<&'static str>,
    /// ash_a2a class atom (AshA2A.Semantic.Refusal).
    pub ash_a2a_class: &'static str,
}

{% set_global n_codes = 0 %}{% set_global n_valves = 0 %}{% set_global n_classes = 0 %}{% set_global n_a2a = 0 %}{% for row in results %}{% if row.classIri %}{% set_global n_classes = n_classes + 1 %}{% elif row.a2aClass %}{% set_global n_a2a = n_a2a + 1 %}{% elif row.valveName %}{% set_global n_valves = n_valves + 1 %}{% else %}{% set_global n_codes = n_codes + 1 %}{% endif %}{% endfor %}
/// The declared ash_a2a refusal classes (refused ++ blocked ++
/// unsupported), projected from the ontology. Classification vocabulary;
/// never a DO authority.
pub const ASH_A2A_CLASSES: [&str; {{ n_classes }}] = [
{% for row in results %}{% if row.classIri %}    "{{ row.className }}",
{% endif %}{% endfor %}];

/// A2A/JSON-RPC error law set (error.ex: standard codes plus -32001..-32009,
/// plus -32000, the JSON-RPC 2.0 spec-reserved server-implementation range
/// -32000..-32099, used by ash_a2a transport/plug.ex wire_error/1 for
/// server_busy/rate_limited).
pub const JSON_RPC_LAW_CODES: [i32; 15] = [
    -32700, -32600, -32601, -32602, -32603, -32000, -32001, -32002, -32003,
    -32004, -32005, -32006, -32007, -32008, -32009,
];

/// One ash_a2a transport-native refusal atom mapped to one ash_a2a class
/// (fourth column: rv:A2aWireMapping; runtime.ex dispatch_check/1 ->
/// transport/plug.ex wire_error/1, wire code -32000).
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct A2aWireEntry {
    /// Transport runtime refusal atom (runtime.ex dispatch_check/1).
    pub a2a_atom: &'static str,
    /// ash_a2a class atom (AshA2A.Semantic.Refusal).
    pub ash_a2a_class: &'static str,
    /// Designated wire code (always -32000: the spec-reserved
    /// server-implementation range code).
    pub json_rpc_code: i32,
}

/// Total crosswalk table: one row per erlmcp code.
pub const CROSSWALK: [CrosswalkEntry; {{ n_codes }}] = [
{% for row in results %}{% if row.code %}    CrosswalkEntry {
        erlmcp_code: {{ row.code }},
        ash_a2a_class: "{{ row.className }}",
        json_rpc_code: {% if row.jsonrpc %}Some({{ row.jsonrpc }}){% else %}None{% endif %},
        http_status: {{ row.http }},
        severity: "{{ row.severity }}",
    },
{% endif %}{% endfor %}];

/// ash_a2a transport wire crosswalk (fourth column): one row per
/// transport-native refusal atom, each mapped to exactly one ash_a2a class
/// with the designated -32000 wire code.
pub const A2A_WIRE_CROSSWALK: [A2aWireEntry; {{ n_a2a }}] = [
{% for row in results %}{% if row.a2aClass %}    A2aWireEntry {
        a2a_atom: "{{ row.a2aAtom }}",
        ash_a2a_class: "{{ row.className }}",
        json_rpc_code: {{ row.jsonrpc }},
    },
{% endif %}{% endfor %}];

/// Valve crosswalk table (third column): one row per declared strata-valve
/// refusal class, each mapped to exactly one ash_a2a class.
pub const VALVE_CROSSWALK: [ValveEntry; {{ n_valves }}] = [
{% for row in results %}{% if row.valveName %}    ValveEntry {
        valve_name: "{{ row.valveName }}",
        valve_module: "{{ row.valveModule }}",
        valve_atom: {% if row.valveAtom %}Some("{{ row.valveAtom }}"){% else %}None{% endif %},
        ash_a2a_class: "{{ row.className }}",
    },
{% endif %}{% endfor %}];

/// Look up the ash_a2a class for an erlmcp code. Fail-closed: an unknown
/// code returns None — the caller must refuse, never guess.
pub fn class_for(erlmcp_code: u16) -> Option<&'static str> {
    CROSSWALK
        .iter()
        .find(|e| e.erlmcp_code == erlmcp_code)
        .map(|e| e.ash_a2a_class)
}

/// Look up the ash_a2a class for a strata valve refusal atom. Fail-closed:
/// an unknown atom returns None — the caller must refuse, never guess.
pub fn valve_class_for(valve_name: &str) -> Option<&'static str> {
    VALVE_CROSSWALK
        .iter()
        .find(|e| e.valve_name == valve_name)
        .map(|e| e.ash_a2a_class)
}

/// Look up the ash_a2a class for a transport-native refusal atom. Fail-closed:
/// an unknown atom returns None — the caller must refuse, never guess.
pub fn a2a_class_for(a2a_atom: &str) -> Option<&'static str> {
    A2A_WIRE_CROSSWALK
        .iter()
        .find(|e| e.a2a_atom == a2a_atom)
        .map(|e| e.ash_a2a_class)
}

#[cfg(test)]
mod tests {
    use super::*;

    /// G1: every erlmcp code appears EXACTLY once (no duplicates, no gaps
    /// against the declared count of {{ n_codes }}).
    #[test]
    fn every_code_mapped_exactly_once() {
        let mut codes: Vec<u16> = CROSSWALK.iter().map(|e| e.erlmcp_code).collect();
        codes.sort_unstable();
        codes.dedup();
        assert_eq!(codes.len(), CROSSWALK.len(), "duplicate erlmcp code");
    }

    /// G2: every declared ash_a2a class is targeted by >= 1 erlmcp code.
    #[test]
    fn every_class_targeted_at_least_once() {
        for class in ASH_A2A_CLASSES.iter() {
            let hits = CROSSWALK.iter().filter(|e| e.ash_a2a_class == *class).count();
            assert!(hits >= 1, "class {} targeted by zero codes", class);
        }
    }

    /// G3: every declared jsonRpcCode stays inside the error.ex law set.
    #[test]
    fn json_rpc_codes_within_law_set() {
        for e in CROSSWALK {
            if let Some(code) = e.json_rpc_code {
                assert!(
                    JSON_RPC_LAW_CODES.contains(&code),
                    "code {} carries jsonRpcCode {} outside the law set",
                    e.erlmcp_code,
                    code
                );
            }
        }
    }

    /// Every mapped class is one of the declared classes (no invented classes).
    #[test]
    fn no_invented_classes() {
        for e in CROSSWALK {
            assert!(
                ASH_A2A_CLASSES.contains(&e.ash_a2a_class),
                "undeclared class {}",
                e.ash_a2a_class
            );
        }
    }

    /// G5 (valve totality, direction 1): every declared valve class appears
    /// exactly once in VALVE_CROSSWALK — count-of-declared, no literals.
    #[test]
    fn every_valve_class_mapped_exactly_once() {
        let mut names: Vec<&str> = VALVE_CROSSWALK.iter().map(|e| e.valve_name).collect();
        names.sort_unstable();
        names.dedup();
        assert_eq!(names.len(), VALVE_CROSSWALK.len(), "duplicate valve class");
    }

    /// G5 (valve totality, direction 2): every valve mapping targets a
    /// declared ash_a2a class, and every declared class is valve-targeted
    /// or code-targeted (the union covers the vocabulary).
    #[test]
    fn valve_targets_are_declared_classes() {
        for e in VALVE_CROSSWALK {
            assert!(
                ASH_A2A_CLASSES.contains(&e.ash_a2a_class),
                "valve mapping to undeclared class {}",
                e.ash_a2a_class
            );
        }
    }

    /// Fail-closed lookups: known keys resolve; unknown keys return None.
    #[test]
    fn lookups_are_fail_closed() {
        assert_eq!(class_for(1021), Some("refused_structure"));
        assert_eq!(class_for(1014), Some("refused_authority"));
        assert_eq!(class_for(9999), None);
        assert_eq!(valve_class_for("malformed_frame"), Some("refused_structure"));
        assert_eq!(valve_class_for("fuel_exhausted"), Some("refused_bounds"));
        assert_eq!(valve_class_for("parent_discontinuity"), Some("refused_receipt"));
        assert_eq!(valve_class_for("arena_failure"), Some("refused_consequence"));
        assert_eq!(valve_class_for("window_run_capacity"), Some("refused_bounds"));
        assert_eq!(valve_class_for("window_tau_capacity"), Some("refused_bounds"));
        assert_eq!(valve_class_for("nonexistent_valve"), None);
    }

    /// G3 negative witness: -31999 (outside every law range -- not a standard
    /// code, not A2A-specific -32001..-32009, not the reserved server range
    /// -32000..-32099) stays outside the law set; the law set grows only by
    /// adjudicated admission.
    #[test]
    fn negative_witness_31999_refuses() {
        assert!(!JSON_RPC_LAW_CODES.contains(&-31999));
        // The admitted -32000 (spec-reserved server-implementation range)
        // must be present exactly once.
        assert!(JSON_RPC_LAW_CODES.contains(&-32000));
        assert_eq!(
            JSON_RPC_LAW_CODES.iter().filter(|&&c| c == -32000).count(),
            1
        );
    }

    /// G6 (a2a wire totality): every transport atom mapped exactly once,
    /// every mapping targets a declared class, and every wire code is the
    /// designated -32000.
    #[test]
    fn a2a_wire_mappings_are_total_and_lawful() {
        let mut atoms: Vec<&str> = A2A_WIRE_CROSSWALK.iter().map(|e| e.a2a_atom).collect();
        atoms.sort_unstable();
        atoms.dedup();
        assert_eq!(atoms.len(), A2A_WIRE_CROSSWALK.len(), "duplicate a2a atom");
        for e in A2A_WIRE_CROSSWALK {
            assert!(
                ASH_A2A_CLASSES.contains(&e.ash_a2a_class),
                "a2a mapping to undeclared class {}",
                e.ash_a2a_class
            );
            assert_eq!(
                e.json_rpc_code, -32000,
                "a2a wire code must be the designated -32000"
            );
        }
        // The runtime's actual atom set (runtime.ex dispatch_check/1) is
        // fully covered.
        assert_eq!(a2a_class_for("server_busy"), Some("blocked_resource"));
        assert_eq!(a2a_class_for("rate_limited"), Some("refused_bounds"));
        assert_eq!(a2a_class_for("unknown_atom"), None);
    }
}
