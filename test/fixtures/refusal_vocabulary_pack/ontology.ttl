rv:macro-refusal-queue-cap-exceeded a rv:DeclaredMacro ; rv:macroName "REFUSAL_QUEUE_CAP_EXCEEDED" .
rv:macro-refusal-queue-tenant-cap-exceeded a rv:DeclaredMacro ; rv:macroName "REFUSAL_QUEUE_TENANT_CAP_EXCEEDED" .
