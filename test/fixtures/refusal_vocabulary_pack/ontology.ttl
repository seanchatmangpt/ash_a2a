rv:macro-refusal-rate-limit-per-minute a rv:DeclaredMacro ; rv:macroName "REFUSAL_RATE_LIMIT_PER_MINUTE" .
rv:macro-refusal-rate-limit-per-second a rv:DeclaredMacro ; rv:macroName "REFUSAL_RATE_LIMIT_PER_SECOND" .
rv:macro-refusal-resource-duplicate a rv:DeclaredMacro ; rv:macroName "REFUSAL_RESOURCE_DUPLICATE" .
rv:macro-refusal-resource-exhausted a rv:DeclaredMacro ; rv:macroName "REFUSAL_RESOURCE_EXHAUSTED" .
rv:macro-refusal-resource-not-found a rv:DeclaredMacro ; rv:macroName "REFUSAL_RESOURCE_NOT_FOUND" .
