# ---------------------------------------------------------------------------
# strata-valve refusal classes (packs/strata-valve-pack/ontology.ttl, valve.ex
# atoms + the knhk WindowCapacityRefusal family). This is the third crosswalk
# column: rv:ValveMapping maps each valve refusal class onto the same ash_a2a
# S42 classes the erlmcp codes use.
# ---------------------------------------------------------------------------

rv:ValveClass a rdfs:Class ;
    dct:title "strata valve refusal class" ;
    dct:description "A refusal atom produced by the strata valve (valve.ex) or the knhk WindowCapacityRefusal guard family." .

rv:valveName a rdf:Property ; rdfs:label "valveName" ;
    dct:description "The valve refusal atom as produced by valve.ex / knhk guards." .
rv:valveModule a rdf:Property ; rdfs:label "valveModule" ;
    dct:description "Source module whose guard produced the refusal atom (provenance only)." .
rv:valveAtom a rdf:Property ; rdfs:label "valveAtom" ;
    dct:description "The guard's literal error atom (e.g. \"run.len > 8\") where one exists." .
rv:order a rdf:Property ; rdfs:label "order" ;
    dct:description "Stable projection order for valve rows in the generated table." .

rv:vc-malformed-frame a rv:ValveClass ;
    rv:order 1 ; 
    rv:valveName "malformed_frame" ; rv:valveModule "Strata.Valve.Refusals.MalformedFrame" ;
    dct:description "Frame failed the strict 64-byte header pattern match (bad magic/version, non-zero reserved, permutation > 5, wrong length)." .
rv:vc-fuel-exhausted a rv:ValveClass ;
    rv:order 2 ; 
    rv:valveName "fuel_exhausted" ; rv:valveModule "Strata.Valve.Refusals.FuelExhausted" ;
    dct:description "Header fuel lease is zero: refused before arena handoff." .
rv:vc-parent-discontinuity a rv:ValveClass ;
    rv:order 3 ; 
    rv:valveName "parent_discontinuity" ; rv:valveModule "Strata.Valve.Refusals.ParentDiscontinuity" ;
    dct:description "Frame parent digest does not equal the valve's active parent_digest register." .
rv:vc-arena-failure a rv:ValveClass ;
    rv:order 4 ; 
    rv:valveName "arena_failure" ; rv:valveModule "Strata.Valve.Refusals.ArenaFailure" ;
    dct:description "Arena returned ok without a 256-bit commit_hash status map, or propagated a non-atom error." .
rv:vc-window-run-capacity a rv:ValveClass ;
    rv:order 5 ; 
    rv:valveName "window_run_capacity" ; rv:valveModule "knhk_hooks.erl" ; rv:valveAtom "run.len > 8" ;
    dct:description "Run-length window guard: hook install refused when Len > 8 (WindowCapacityRefusal family, Chatman constant k = 8)." .
rv:vc-window-tau-capacity a rv:ValveClass ;
    rv:order 6 ; 
    rv:valveName "window_tau_capacity" ; rv:valveModule "knhk_epoch.erl" ; rv:valveAtom "tau > 8" ;
    dct:description "Epoch tau window guard: schedule refused when Tau > 8 (WindowCapacityRefusal family, Chatman constant k = 8)." .

# ---------------------------------------------------------------------------
# Valve crosswalk: rv:ValveMapping (strata valve class -> ash_a2a S42 class),
# per the L101-verified adjudication.
# ---------------------------------------------------------------------------

rv:ValveMapping a rdfs:Class ;
    dct:title "valve crosswalk mapping" ;
    dct:description "Maps exactly one strata-valve refusal class onto exactly one declared ash_a2a refusal class." .

rv:valveClass a rdf:Property ; rdfs:label "valveClass" ;
    dct:description "The mapped strata-valve refusal class (exactly one per ValveMapping)." .

rv:vm-malformed-frame a rv:ValveMapping ;
    rv:valveClass rv:vc-malformed-frame ;
    rv:ashA2aClass rv:cls-refused-structure ;
    dct:description "Wire shape wrong: unparsable/non-compliant frame header -> refused_structure (same class as erlmcp 1066/1021)." .
rv:vm-fuel-exhausted a rv:ValveMapping ;
    rv:valveClass rv:vc-fuel-exhausted ;
    rv:ashA2aClass rv:cls-refused-bounds ;
    dct:description "Declared fuel lease (a resource bound) exhausted -> refused_bounds (same class as erlmcp 1056/1068)." .
rv:vm-parent-discontinuity a rv:ValveMapping ;
    rv:valveClass rv:vc-parent-discontinuity ;
    rv:ashA2aClass rv:cls-refused-receipt ;
    dct:description "Parent digest cannot be re-anchored to the active register -> refused_receipt (receipt/replay anchoring failure, same family as erlmcp 1012)." .
rv:vm-arena-failure a rv:ValveMapping ;
    rv:valveClass rv:vc-arena-failure ;
    rv:ashA2aClass rv:cls-refused-consequence ;
    dct:description "Arena effect completed without its lawful 256-bit consequence receipt -> refused_consequence (same family as erlmcp 1049/1060)." .
rv:vm-window-run-capacity a rv:ValveMapping ;
    rv:valveClass rv:vc-window-run-capacity ;
    rv:ashA2aClass rv:cls-refused-bounds ;
    dct:description "Window capacity guard run.len > 8 (declared bound breached) -> refused_bounds." .
rv:vm-window-tau-capacity a rv:ValveMapping ;
    rv:valveClass rv:vc-window-tau-capacity ;
    rv:ashA2aClass rv:cls-refused-bounds ;
    dct:description "Window capacity guard tau > 8 (declared bound breached) -> refused_bounds." .
