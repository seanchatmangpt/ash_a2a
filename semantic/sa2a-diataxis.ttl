@prefix sa2a: <https://seanchatmangpt.github.io/sa2a/diataxis#> .
@prefix a2a: <https://seanchatmangpt.github.io/ash-a2a#> .

# Authority: engineering-standards CapabilityShape requires seven edges per
# capability (learnedBy, executedBy, specifiedBy, constrainedBy, verifiedBy,
# repairedBy, evidencedBy). This profile binds them for ash_a2a's six exports.

<urn:sa2a:repo:ash_a2a> a sa2a:RepositoryProfile ;
  sa2a:sourceRepo "seanchatmangpt/ash_a2a" ;
  sa2a:role "runtime" ;
  sa2a:authority <https://github.com/seanchatmangpt/engineering-standards/tree/main/semantic/sa2a-diataxis> ;
  sa2a:generator <https://github.com/seanchatmangpt/engineering-standards/tree/main/semantic/sa2a-diataxis> ;
  sa2a:exports
    <urn:sa2a:capability:discover>,
    <urn:sa2a:capability:select>,
    <urn:sa2a:capability:construct>,
    <urn:sa2a:capability:do>,
    <urn:sa2a:capability:receipt>,
    <urn:sa2a:capability:replay> .

# --- Explanation laws (constrainedBy) ---------------------------------------

<urn:sa2a:law:select-not-construct> a sa2a:ExplanationLaw ;
  sa2a:path "docs/archive/rfc/RFC-SA2A-001-v26.9.16.md" ;
  sa2a:falsifier "SELECT result treated as CONSTRUCT standing" .

<urn:sa2a:law:construct-not-do> a sa2a:ExplanationLaw ;
  sa2a:path "docs/archive/rfc/RFC-SA2A-001-v26.9.16.md" ;
  sa2a:falsifier "CONSTRUCT artifact treated as DO authority" .

<urn:sa2a:law:intent-not-authority> a sa2a:ExplanationLaw ;
  sa2a:path "docs/explanation/architecture.md" ;
  sa2a:falsifier "intent or plan package treated as Authority grant" .

<urn:sa2a:law:receipt-not-success> a sa2a:ExplanationLaw ;
  sa2a:path "docs/explanation/chicago-conformance-court.md" ;
  sa2a:falsifier "receipt presence treated as domain success" .

<urn:sa2a:law:discover-not-do> a sa2a:ExplanationLaw ;
  sa2a:path "docs/reference/agent-card-honesty.md" ;
  sa2a:falsifier "agent card skill advertisement treated as actuation grant" .

<urn:sa2a:law:replay-not-actuate> a sa2a:ExplanationLaw ;
  sa2a:path "docs/how-to/replay-receipt-basis.md" ;
  sa2a:falsifier "replayed AuthorityRecord re-enters CommandBus as Authority" .

# --- Shared tutorial trajectory ---------------------------------------------

<urn:sa2a:tutorial:thin-waist> a sa2a:TutorialTrajectory ;
  sa2a:path "docs/tutorials/walk-the-sa2a-thin-waist.md" .

# --- Receipt bindings (evidencedBy) -----------------------------------------

<urn:sa2a:receipt:card-honesty> a sa2a:ReceiptBinding ;
  sa2a:path "lib/ash_a2a/protocol/agent_card_signature.ex" .

<urn:sa2a:receipt:selection> a sa2a:ReceiptBinding ;
  sa2a:path "lib/ash_a2a/semantic/select.ex" .

<urn:sa2a:receipt:construction> a sa2a:ReceiptBinding ;
  sa2a:path "lib/ash_a2a/semantic/construct.ex" .

<urn:sa2a:receipt:actuation> a sa2a:ReceiptBinding ;
  sa2a:path "lib/ash_a2a/receipt.ex" .

<urn:sa2a:receipt:binding-check> a sa2a:ReceiptBinding ;
  sa2a:path "lib/ash_a2a/receipt/binding.ex" .

<urn:sa2a:receipt:replay-basis> a sa2a:ReceiptBinding ;
  sa2a:path "lib/ash_a2a/receipt/replay.ex" .

# --- Diátaxis edge nodes (typed + sa2a:path) ---------------------------------

# discover
<urn:sa2a:contract:discover> a sa2a:ReferenceContract ;
  sa2a:path "docs/reference/agent-card-honesty.md" .
<urn:sa2a:howto:discover> a sa2a:HowToMethod ;
  sa2a:path "docs/how-to/sign-agent-cards.md" .
<urn:sa2a:gate:discover> a sa2a:VerificationGate ;
  sa2a:path "test/ash_a2a/protocol/agent_card_honesty_test.exs" .
<urn:sa2a:repair:discover> a sa2a:RepairRoute ;
  sa2a:path "docs/how-to/repair-agent-card-drift.md" ;
  sa2a:failureClass "agent_card_drift" .

<urn:sa2a:capability:discover> a sa2a:Capability ;
  sa2a:learnedBy <urn:sa2a:tutorial:thin-waist> ;
  sa2a:specifiedBy <urn:sa2a:contract:discover> ;
  sa2a:executedBy <urn:sa2a:howto:discover> ;
  sa2a:constrainedBy <urn:sa2a:law:discover-not-do> ;
  sa2a:verifiedBy <urn:sa2a:gate:discover> ;
  sa2a:repairedBy <urn:sa2a:repair:discover> ;
  sa2a:evidencedBy <urn:sa2a:receipt:card-honesty> .

# select
<urn:sa2a:contract:select> a sa2a:ReferenceContract ;
  sa2a:path "lib/ash_a2a/semantic/select.ex" .
<urn:sa2a:howto:select> a sa2a:HowToMethod ;
  sa2a:path "docs/how-to/select-among-plan-packages.md" .
<urn:sa2a:gate:select> a sa2a:VerificationGate ;
  sa2a:path "test/ash_a2a/semantic_select_test.exs" .
<urn:sa2a:repair:select> a sa2a:RepairRoute ;
  sa2a:path "lib/ash_a2a/chicago/courts/plan_package.ex" ;
  sa2a:failureClass "select_implies_authority" .

<urn:sa2a:capability:select> a sa2a:Capability ;
  sa2a:learnedBy <urn:sa2a:tutorial:thin-waist> ;
  sa2a:specifiedBy <urn:sa2a:contract:select> ;
  sa2a:executedBy <urn:sa2a:howto:select> ;
  sa2a:constrainedBy <urn:sa2a:law:select-not-construct> ;
  sa2a:verifiedBy <urn:sa2a:gate:select> ;
  sa2a:repairedBy <urn:sa2a:repair:select> ;
  sa2a:evidencedBy <urn:sa2a:receipt:selection> .

# construct
<urn:sa2a:contract:construct> a sa2a:ReferenceContract ;
  sa2a:path "lib/ash_a2a/semantic/construct.ex" .
<urn:sa2a:howto:construct> a sa2a:HowToMethod ;
  sa2a:path "docs/how-to/construct-from-admitted-semantics.md" .
<urn:sa2a:gate:construct> a sa2a:VerificationGate ;
  sa2a:path "test/ash_a2a/semantic_construct_test.exs" .
<urn:sa2a:repair:construct> a sa2a:RepairRoute ;
  sa2a:path "lib/ash_a2a/chicago/courts/plan_package.ex" ;
  sa2a:failureClass "construct_implies_do" .

<urn:sa2a:capability:construct> a sa2a:Capability ;
  sa2a:learnedBy <urn:sa2a:tutorial:thin-waist> ;
  sa2a:specifiedBy <urn:sa2a:contract:construct> ;
  sa2a:executedBy <urn:sa2a:howto:construct> ;
  sa2a:constrainedBy <urn:sa2a:law:select-not-construct>, <urn:sa2a:law:construct-not-do> ;
  sa2a:verifiedBy <urn:sa2a:gate:construct> ;
  sa2a:repairedBy <urn:sa2a:repair:construct> ;
  sa2a:evidencedBy <urn:sa2a:receipt:construction> .

# do
<urn:sa2a:contract:do> a sa2a:ReferenceContract ;
  sa2a:path "lib/ash_a2a/command_bus.ex" .
<urn:sa2a:howto:do> a sa2a:HowToMethod ;
  sa2a:path "docs/how-to/test-governed-actions.md" .
<urn:sa2a:gate:do> a sa2a:VerificationGate ;
  sa2a:path "lib/ash_a2a/chicago/courts/authority_non_implication.ex" .
<urn:sa2a:repair:do> a sa2a:RepairRoute ;
  sa2a:path "lib/ash_a2a/chicago/mutation/catalog.ex" ;
  sa2a:failureClass "unreceipted_or_unauthorized_do" .

<urn:sa2a:capability:do> a sa2a:Capability ;
  sa2a:learnedBy <urn:sa2a:tutorial:thin-waist> ;
  sa2a:specifiedBy <urn:sa2a:contract:do> ;
  sa2a:executedBy <urn:sa2a:howto:do> ;
  sa2a:constrainedBy <urn:sa2a:law:construct-not-do>, <urn:sa2a:law:intent-not-authority> ;
  sa2a:verifiedBy <urn:sa2a:gate:do> ;
  sa2a:repairedBy <urn:sa2a:repair:do> ;
  sa2a:evidencedBy <urn:sa2a:receipt:actuation> .

# receipt
<urn:sa2a:contract:receipt> a sa2a:ReferenceContract ;
  sa2a:path "lib/ash_a2a/receipt.ex" .
<urn:sa2a:howto:receipt> a sa2a:HowToMethod ;
  sa2a:path "docs/how-to/test-governed-actions.md" .
<urn:sa2a:gate:receipt> a sa2a:VerificationGate ;
  sa2a:path "lib/ash_a2a/chicago/courts/receipt_binding.ex" .
<urn:sa2a:repair:receipt> a sa2a:RepairRoute ;
  sa2a:path "lib/ash_a2a/chicago/mutation/catalog.ex" ;
  sa2a:failureClass "remove_receipt_preparation" ;
  sa2a:falsifier "pending receipt anchor skipped before DO" .

<urn:sa2a:capability:receipt> a sa2a:Capability ;
  sa2a:learnedBy <urn:sa2a:tutorial:thin-waist> ;
  sa2a:specifiedBy <urn:sa2a:contract:receipt> ;
  sa2a:executedBy <urn:sa2a:howto:receipt> ;
  sa2a:constrainedBy <urn:sa2a:law:receipt-not-success> ;
  sa2a:verifiedBy <urn:sa2a:gate:receipt> ;
  sa2a:repairedBy <urn:sa2a:repair:receipt> ;
  sa2a:evidencedBy <urn:sa2a:receipt:binding-check> .

# replay
<urn:sa2a:contract:replay> a sa2a:ReferenceContract ;
  sa2a:path "lib/ash_a2a/receipt/replay.ex" .
<urn:sa2a:howto:replay> a sa2a:HowToMethod ;
  sa2a:path "docs/how-to/replay-receipt-basis.md" .
<urn:sa2a:gate:replay> a sa2a:VerificationGate ;
  sa2a:path "lib/ash_a2a/chicago/courts/offline_replay.ex" .
<urn:sa2a:repair:replay> a sa2a:RepairRoute ;
  sa2a:path "lib/ash_a2a/chicago/mutation/catalog.ex" ;
  sa2a:failureClass "replay_calls_actuator" ;
  sa2a:falsifier "committed receipt path re-enters actuator" .

<urn:sa2a:capability:replay> a sa2a:Capability ;
  sa2a:learnedBy <urn:sa2a:tutorial:thin-waist> ;
  sa2a:specifiedBy <urn:sa2a:contract:replay> ;
  sa2a:executedBy <urn:sa2a:howto:replay> ;
  sa2a:constrainedBy <urn:sa2a:law:replay-not-actuate> ;
  sa2a:verifiedBy <urn:sa2a:gate:replay> ;
  sa2a:repairedBy <urn:sa2a:repair:replay> ;
  sa2a:evidencedBy <urn:sa2a:receipt:replay-basis> .
