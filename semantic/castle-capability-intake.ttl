@prefix eco: <https://ggen.dev/ecosystem#> .
@prefix a2a: <https://ash-a2a.dev/ontology/castle-intake#> .

a2a:intake
    a eco:CapabilityProjection ;
    eco:projectionSource "seanchatmangpt/ggen-ecosystem@50fdfa20c84205a80c6eb94e916cffbedc4b816e" ;
    eco:ownerRepository "seanchatmangpt/ash_a2a" ;
    eco:ownerCapability "SA2A_TRANSPORT" ;
    eco:projectionStanding "CANDIDATE" ;
    eco:authorityCeiling "CONSTRUCT" ;
    eco:forbidsCapability "CONSEQUENTIAL_ADMISSIBILITY", "RUNTIME_EXISTENCE" .

a2a:ash-atlassian
    a eco:ProjectedCapability ;
    eco:sourceRepository "seanchatmangpt/ash_atlassian" ;
    eco:sourceSha "43e3d21b7c4e4571493fcf3757392ed16f2dd967" ;
    eco:capability "WORK_SYSTEM_ADAPTER" ;
    eco:disposition "WRAP" ;
    eco:runtimePlacement "EXTERNAL_SYSTEM_ADAPTER" ;
    eco:projectionTarget a2a:intake ;
    eco:falsifier "Atlassian/Jira state becomes authority or bypasses SA2A exact-subject identity." .

a2a:ash-planning-center
    a eco:ProjectedCapability ;
    eco:sourceRepository "seanchatmangpt/ash_planning_center" ;
    eco:sourceSha "5ee26cbdc8fef26c92c7691355c76f5aed2e7b2c" ;
    eco:capability "PLANNING_CENTER_ADAPTER" ;
    eco:disposition "WRAP" ;
    eco:runtimePlacement "EXTERNAL_SYSTEM_ADAPTER" ;
    eco:projectionTarget a2a:intake ;
    eco:falsifier "Planning Center state creates private authorization semantics or bypasses exact-subject transport." .

a2a:agile-protocol
    a eco:ProjectedCapability ;
    eco:sourceRepository "seanchatmangpt/agile-protocol-specification" ;
    eco:sourceSha "1b731a6e963fa249c4e3e8bcbe932025c5e38bb5" ;
    eco:capability "PROTOCOL_SPECIFICATION_KNOWLEDGE" ;
    eco:disposition "KEEP_KNOWLEDGE_PLANE" ;
    eco:runtimePlacement "KNOWLEDGE_PLANE_ONLY" ;
    eco:projectionTarget a2a:intake ;
    eco:falsifier "Protocol prose/specification becomes transport authority without an executed implementation receipt." .
