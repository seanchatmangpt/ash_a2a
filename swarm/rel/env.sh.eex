#!/bin/sh
# Sourced by bin/swarm_node for EVERY command (start, rpc, remote, eval).
#
# Distribution over TLS by default (DEP-07 / SEC-10): the cookie alone grants
# remote code execution to anyone who can reach 4369/9000, and cleartext dist
# fails data-in-transit controls (NIST SP 800-53 SC-8). With inet_tls, a peer
# must also present a certificate issued by the cluster CA (verify_peer +
# fail_if_no_peer_cert in ssl_dist.conf).
#
#   SWARM_DIST_TLS          true (default) | false (local dev ONLY, logged)
#   SWARM_DIST_TLS_OPTFILE  default $RELEASE_ROOT/ssl_dist.conf; the default
#                           file reads certs from /etc/ash_a2a/dist/{tls.crt,
#                           tls.key,ca.crt} (the k8s Secret mount).
#   SWARM_SCHEDULERS        optional N -> +S N:N (match the pod CPU limit).
case "${SWARM_DIST_TLS:-true}" in
  true)
    SWARM_DIST_TLS_OPTFILE="${SWARM_DIST_TLS_OPTFILE:-$RELEASE_ROOT/ssl_dist.conf}"
    if [ ! -r "$SWARM_DIST_TLS_OPTFILE" ]; then
      echo "ERROR: SWARM_DIST_TLS=true but ssl_dist optfile is not readable: $SWARM_DIST_TLS_OPTFILE" >&2
      exit 1
    fi
    ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} -proto_dist inet_tls -ssl_dist_optfile $SWARM_DIST_TLS_OPTFILE"
    ;;
  false)
    echo "WARNING: SWARM_DIST_TLS=false -- Erlang distribution is CLEARTEXT and cookie-only. Never use this outside local development." >&2
    ;;
  *)
    echo "ERROR: SWARM_DIST_TLS must be true or false, got: ${SWARM_DIST_TLS}" >&2
    exit 1
    ;;
esac

if [ -n "${SWARM_SCHEDULERS:-}" ]; then
  ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} +S ${SWARM_SCHEDULERS}:${SWARM_SCHEDULERS}"
fi

export ELIXIR_ERL_OPTIONS
