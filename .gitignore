# The directory Mix will write compiled artifacts to.
/_build/

# Per-lane / per-merge build roots (MIX_BUILD_ROOT=_build-<lane>) used by
# same-checkout agent fan-out: build output, never source.
/_build-*/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
ash_a2a-*.tar

# Local ULTRACODE receipts/logs are runtime evidence, not repository source.
/.ultracode/state/

# swarm/ is its own real, separate Mix project (see swarm/mix.exs's
# moduledoc) -- its own build/deps/lock artifacts, same reasoning as the
# root-level entries above.
/swarm/_build/
/swarm/deps/

# Local zcode work / plan artifacts
/.zcode/


# lane-lease build roots (fan-out campaign)
target/
node_modules/
.DS_Store
_build-lane*/
target-lane*/
